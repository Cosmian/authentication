#!/usr/bin/env bash
#MISE description="Build packages via Nix. Usage: mise run package -- [--link static|dynamic] [--variant default|saml] [deb|rpm|dmg]"
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"

# nix.sh expects: [--link X] [--variant Y] package [deb|rpm|dmg]
split_nix_global_args "$@"

print_status "Building packages (${NIX_GLOBAL_ARGS[*]:-defaults})"
exec bash "${MISE_CONFIG_ROOT}/.github/scripts/nix.sh" ${NIX_GLOBAL_ARGS[@]+"${NIX_GLOBAL_ARGS[@]}"} package ${NIX_REST_ARGS[@]+"${NIX_REST_ARGS[@]}"}
