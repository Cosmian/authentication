#!/usr/bin/env bash
#MISE description="Build packages via Nix. Usage: mise run package -- [--link static|dynamic] [deb|rpm|dmg]"
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"

# nix.sh expects: [--link static|dynamic] package [deb|rpm|dmg]
# Splice the literal "package" command word in after an optional leading --link pair.
LINK_ARGS=()
if [ "${1:-}" = "--link" ] || [ "${1:-}" = "-l" ]; then
  LINK_ARGS=(--link "${2:?missing value for --link}")
  shift 2
fi

print_status "Building packages (${LINK_ARGS[1]:-static} link)"
exec bash "${MISE_CONFIG_ROOT}/.github/scripts/nix.sh" "${LINK_ARGS[@]}" package "$@"
