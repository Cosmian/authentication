#!/usr/bin/env bash
#MISE description="Regenerate expected binary hashes. Usage: mise run hashes:update -- [--link static|dynamic] [--variant default|saml]"
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"

split_nix_global_args "$@"

print_status "Updating expected hashes (${NIX_GLOBAL_ARGS[*]:-defaults})"
exec bash "${MISE_CONFIG_ROOT}/.github/scripts/nix.sh" ${NIX_GLOBAL_ARGS[@]+"${NIX_GLOBAL_ARGS[@]}"} update-hashes ${NIX_REST_ARGS[@]+"${NIX_REST_ARGS[@]}"}
