{
    "name": "admin-ui",
    "private": true,
    "version": "0.4.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:real": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "lint": "eslint . --fix",
        "format": "prettier . --write",
        "test": "vitest --run -c tests/vitest.unit.config.ts",
        "test:unit": "vitest --run -c tests/vitest.unit.config.ts",
        "test:integration": "vitest --run -c tests/vitest.int.config.ts",
        "test:e2e": "playwright test",
        "test:all": "vitest --run -c tests/vitest.unit.config.ts && vitest --run -c tests/vitest.int.config.ts && playwright test",
        "ci": "eslint . --fix && prettier . --write && vitest --run -c tests/vitest.unit.config.ts && vitest --run -c tests/vitest.int.config.ts && playwright test"
    },
    "dependencies": {
        "@ant-design/icons": "^6.3.4",
        "@tailwindcss/vite": "^4.2.2",
        "antd": "^6.6.3",
        "qrcode": "^1.5.4",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router": "^8.3.1",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.5.1",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react-swc": "^4.3.3",
        "eslint": "^10.10.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.6",
        "globals": "^17.12.0",
        "jsdom": "^30.0.1",
        "prettier": "^3.8.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.68.0",
        "vite": "^8.3.0",
        "vitest": "^5.0.1"
    },
    "pnpm": {
        "overrides": {
            "ws": ">=8.21.0",
            "esbuild": ">=0.28.1",
            "js-yaml": ">=4.3.0",
            "postcss": ">=8.5.18"
        }
    }
}
