{
    "name": "admin-ui",
    "private": true,
    "version": "0.2.1",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:real": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "lint": "eslint . --fix",
        "format": "prettier . --write",
        "test": "vitest --run -c tests/vitest.unit.config.ts",
        "test:unit": "vitest --run -c tests/vitest.unit.config.ts",
        "test:integration": "vitest --run -c tests/vitest.int.config.ts",
        "test:e2e": "playwright test",
        "test:all": "vitest --run -c tests/vitest.unit.config.ts && vitest --run -c tests/vitest.int.config.ts && playwright test",
        "ci": "eslint . --fix && prettier . --write && vitest --run -c tests/vitest.unit.config.ts && vitest --run -c tests/vitest.int.config.ts && playwright test"
    },
    "dependencies": {
        "@ant-design/icons": "^6.1.0",
        "@tailwindcss/vite": "^4.2.2",
        "antd": "^5.29.3",
        "qrcode": "^1.5.4",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "react-router-dom": "^7.15.1",
        "tailwindcss": "^4.2.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@playwright/test": "^1.59.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^22.15.0",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react-swc": "^3.11.0",
        "eslint": "^9.39.3",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.26",
        "globals": "^16.5.0",
        "jsdom": "^26.1.0",
        "prettier": "^3.8.1",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.56.0",
        "vite": "^7.3.5",
        "vitest": "^4.1.4"
    },
    "pnpm": {
        "overrides": {
            "ws": ">=8.21.0",
            "esbuild": ">=0.28.1",
            "js-yaml": ">=4.3.0",
            "postcss": ">=8.5.18",
            "brace-expansion": ">=5.0.8"
        }
    }
}
